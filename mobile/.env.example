# API base URL the app talks to.
EXPO_PUBLIC_API_URL=

# Map keys for the order tracking screen (react-native-maps).
# Android: Maps SDK for Android, restricted to com.chowly.app.
# iOS: only needed if iOS uses the Google provider rather than Apple Maps.
# Both are compiled into the native project, so changing one needs a rebuild.
ANDROID_MAPS_KEY=
IOS_MAPS_KEY=
